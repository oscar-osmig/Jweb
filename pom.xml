<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- Keep current with Boot 4.0.x patches (managed Tomcat/Jackson/
		     Framework security fixes ride along). 4.0.7 fixed
		     CVE-2026-29062 via Jackson 3.1.4; 4.0.8 is the Aug 2026 patch. -->
		<version>4.0.8</version>
		<relativePath/>
	</parent>
	<groupId>com.osmig</groupId>
	<artifactId>Jweb</artifactId>
	<version>1.1.0</version>
	<name>Jweb</name>
	<description>JWeb - Build web apps in pure Java</description>
	<url>https://github.com/oscar-osmig/Jweb</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>

	<scm>
		<url>https://github.com/oscar-osmig/Jweb</url>
		<connection>scm:git:https://github.com/oscar-osmig/Jweb.git</connection>
	</scm>

	<properties>
		<java.version>21</java.version>
		<!-- Default build = the publishable LIBRARY: the demo app is excluded and
		     no executable jar is produced. Build the runnable showcase with -Pdemo. -->
		<jweb.demo.excludes>com/osmig/Jweb/app/**</jweb.demo.excludes>
		<jweb.repackage.skip>true</jweb.repackage.skip>
	</properties>

	<profiles>
		<!-- ./mvnw package -Pdemo  →  runnable Jweb-<version>-exec.jar of the sample app -->
		<profile>
			<id>demo</id>
			<properties>
				<jweb.demo.excludes>nothing-is-excluded/**</jweb.demo.excludes>
				<jweb.repackage.skip>false</jweb.repackage.skip>
			</properties>
		</profile>
	</profiles>

	<dependencies>
		<!-- Web support (embedded Tomcat, HTTP handling) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- WebSocket support for reactive state updates -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- DevTools for hot reload during development -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- .env file support -->
		<dependency>
			<groupId>me.paulschwarz</groupId>
			<artifactId>spring-dotenv</artifactId>
			<version>4.0.0</version>
		</dependency>

		<!-- Jackson JSON processing (already included in spring-boot-starter-web, but explicit for clarity) -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- Spring Data JPA for database access (uncomment when needed) -->
		<!-- <dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency> -->

		<!-- MongoDB driver -->
		<dependency>
			<groupId>org.mongodb</groupId>
			<artifactId>mongodb-driver-sync</artifactId>
			<version>5.10.0</version>
		</dependency>
		<dependency>
			<groupId>org.mongodb</groupId>
			<artifactId>bson</artifactId>
			<version>5.10.0</version>
		</dependency>
		<dependency>
			<groupId>org.mongodb</groupId>
			<artifactId>mongodb-driver-core</artifactId>
			<version>5.10.0</version>
		</dependency>

		<!-- Spring Security Crypto for password hashing (BCrypt) -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- JWT support (JJWT) -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.7</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.7</version>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.7</version>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- NOTE: AI integration ships built-in (framework/ai — AI.ask/chat/agent,
		     works with any OpenAI-compatible API, no dependencies needed).
		     The Spring AI starters below are OPTIONAL alternatives. -->
		<!-- Spring AI OpenAI (uncomment to enable AI/LLM integration)
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
			<version>2.0.0-M1</version>
			<optional>true</optional>
		</dependency>
		-->

		<!-- Spring AI Ollama (uncomment for local LLM via Ollama)
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-ollama</artifactId>
			<version>2.0.0-M1</version>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>ollama</artifactId>
			<version>1.20.4</version>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<version>1.20.4</version>
			<optional>true</optional>
		</dependency>
		-->
	</dependencies>

	<build>
		<plugins>
			<!-- Copy framework source files and README to resources for project generation -->
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-framework-sources</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/framework-src</outputDirectory>
							<resources>
								<resource>
									<directory>src/main/java/com/osmig/Jweb/framework</directory>
									<includes>
										<include>**/*.java</include>
										<include>**/*.md</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-readme</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/readme</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}</directory>
									<includes>
										<include>README.md</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Spring Boot plugin -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.osmig.Jweb.app.App</mainClass>
					<!-- Publish as a LIBRARY: the plain jar stays the main artifact
					     (usable as a dependency) and the runnable fat jar becomes
					     Jweb-<version>-exec.jar. Without this, repackage rewrites the
					     main jar into BOOT-INF/classes and consumers get no classes. -->
					<classifier>exec</classifier>
					<jvmArguments>
						--add-opens java.base/sun.misc=ALL-UNNAMED
						--add-opens java.base/java.nio=ALL-UNNAMED
					</jvmArguments>
				</configuration>
				<executions>
					<!-- Skip ONLY repackage in the library build. A plugin-level <skip>
					     would also disable spring-boot:run. -->
					<execution>
						<id>repackage</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<skip>${jweb.repackage.skip}</skip>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Keep the DEMO APP's config out of the published library jar.
			     application.yaml belongs to this repo's sample app (port, admin
			     credentials, Mongo); shipping it would inject those settings —
			     and its credential defaults — into every consuming application.
			     Only jweb.yaml (framework defaults) is published.
			     spring-boot:run still uses target/classes, so local dev is
			     unaffected. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>application.yaml</exclude>
						<exclude>application.properties</exclude>
						<!-- The sample app must not reach consumers: shipping it put
						     com.osmig.Jweb.app.pages.HomePage in their IDE autocomplete. -->
						<exclude>${jweb.demo.excludes}</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Sources jar: JitPack/IDEs show framework source to consumers -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
